<UserControl x:Class="qgrepControls.SearchWindow.qgrepSearchWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:qgrepControls.SearchWindow"
             xmlns:resx="clr-namespace:qgrepControls.Properties"
             xmlns:wpfTool="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
             xmlns:modelViews="clr-namespace:qgrepControls.ModelViews"
             mc:Ignorable="d" Style="{DynamicResource SomeWindow}" x:Name="SearchWindowControl" IsVisibleChanged="SearchWindowControl_IsVisibleChanged"
             d:DesignHeight="600" d:DesignWidth="1000" GotFocus="SearchWindowControl_GotFocus" PreviewKeyDown="SearchWindowControl_PreviewKeyDown" GotKeyboardFocus="SearchWindowControl_GotKeyboardFocus">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/qgrepControls;component/ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type modelViews:HistoricItem}">
                <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <Label Style="{DynamicResource HistoricOperation}" Content="{Binding Path=OperationBeginText}" Visibility="{Binding Path=OperationVisibility}" />
                    <Label Style="{DynamicResource HistoricEntry}" Content="{Binding Path=Text}" />
                    <Label Style="{DynamicResource HistoricOperation}" Content="{Binding Path=OperationEndText}" Visibility="{Binding Path=OperationVisibility}" />
                </StackPanel>
            </DataTemplate>

            <!-- ================= CodeIndex 风格本地样式 =================
                 仅作用于搜索窗体：把外观改成 CodeIndexSearchControl 那样的
                 标准 VS 控件（带边框输入框、标准复选框、文字按钮），不再使用自绘图标。
                 配色统一走调色板资源，因此仍然跟随 VS 主题 / 独立版配色设置。 -->

            <Style x:Key="CiLabel" TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                <Setter Property="FontFamily" Value="{DynamicResource NormalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
                <Setter Property="Padding" Value="0,0,4,0" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 带完整 1px 边框的输入框（原样式只有上下两条线） -->
            <Style x:Key="CiTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource SomeTextBoxStyle}">
                <Setter Property="Height" Value="23" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource NormalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
            </Style>

            <!-- 提示文字：超长时省略号，避免窄窗口里压到其它控件 -->
            <Style x:Key="CiHint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SomeHintLabel}">
                <Setter Property="Padding" Value="6,0,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CiCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SomeCheckBox}">
                <Setter Property="Margin" Value="0,2,10,2" />
                <Setter Property="FontFamily" Value="{DynamicResource NormalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
            </Style>

            <Style x:Key="CiComboBox" TargetType="{x:Type ComboBox}">
                <Setter Property="Height" Value="23" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{DynamicResource NormalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
                <Setter Property="Background" Value="{DynamicResource ComboBox.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource ComboBox.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.Border}" />
                <Setter Property="MaxDropDownHeight" Value="480" />
            </Style>

            <!-- 文字按钮（替代原来的自绘图标按钮），配色与全局按钮样式保持一致 -->
            <Style x:Key="CiButton" TargetType="{x:Type Button}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Background" Value="{DynamicResource Button.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource Button.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Button.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="23" />
                <Setter Property="Margin" Value="0,2,8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FontFamily" Value="{DynamicResource NormalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Button.IsMouseOver.Background}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Button.IsMouseOver.Border}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Button.IsMouseDown.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource Button.IsMouseDown.Foreground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Button.IsMouseDown.Border}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource Button.IsDisabled.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource Button.IsDisabled.Foreground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Button.IsDisabled.Border}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 主操作按钮（搜索）：使用主题强调色 -->
            <Style x:Key="CiAccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CiButton}">
                <Setter Property="Background" Value="{DynamicResource Selection}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource Selection}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Selection}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Selection}" />
                        <Setter Property="Opacity" Value="0.85" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Selection}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Selection}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 停止类按钮 -->
            <Style x:Key="CiWarnButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CiButton}">
                <Setter Property="Background" Value="#C50F1F" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#C50F1F" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#A80000" />
                        <Setter Property="BorderBrush" Value="#A80000" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#A80000" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#A80000" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel LastChildFill="True" Margin="6">
            <!-- ===== 第一行：搜索条件（CodeIndexSearchControl 的 WrapPanel 布局，窄窗口自动换行） ===== -->
            <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Orientation="Horizontal">
                <Grid x:Name="SearchGrid" Margin="0,2,10,2">
                    <TextBox x:Name="SearchInput" TabIndex="0" Width="260" Style="{StaticResource CiTextBox}" TextChanged="SearchInput_TextChanged" LostFocus="SearchInput_LostFocus" KeyDown="SearchInput_KeyDown" />
                    <TextBlock x:Name="SearchLabel" Text="{x:Static resx:Resources.SearchLabel}" Style="{StaticResource CiHint}" />
                </Grid>
                <CheckBox x:Name="SearchCaseSensitive" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.CaseSensitiveLabel}" Click="CaseSensitive_Click" IsChecked="True" />
                <CheckBox x:Name="SearchWholeWord" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.WholeWordLabel}" IsChecked="True" Click="SearchWholeWord_Click" />
                <CheckBox x:Name="SearchRegEx" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.RegExLabel}" IsChecked="True" Click="SearchRegEx_Click" />
                <DockPanel x:Name="IncludeFilesGrid" LastChildFill="True" Margin="0,2,10,2">
                    <CheckBox x:Name="IncludeRegEx" DockPanel.Dock="Right" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.RegExLabel}" Margin="4,0,0,0" VerticalContentAlignment="Center" IsChecked="True" Click="IncludeRegEx_Click" />
                    <Grid>
                        <TextBox x:Name="IncludeFilesInput" TabIndex="1" Width="150" Style="{StaticResource CiTextBox}" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
                        <TextBlock x:Name="IncludeFilesLabel" Text="{x:Static resx:Resources.IncludeFilesLabel}" Style="{StaticResource CiHint}" />
                    </Grid>
                </DockPanel>
                <DockPanel x:Name="ExcludeFilesGrid" LastChildFill="True" Margin="0,2,10,2">
                    <CheckBox x:Name="ExcludeRegEx" DockPanel.Dock="Right" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.RegExLabel}" Margin="4,0,0,0" VerticalContentAlignment="Center" IsChecked="True" Click="ExcludeRegEx_Click" />
                    <Grid>
                        <TextBox x:Name="ExcludeFilesInput" TabIndex="2" Width="150" Style="{StaticResource CiTextBox}" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
                        <TextBlock x:Name="ExcludeFilesLabel" Text="{x:Static resx:Resources.ExcludeFilesLabel}" Style="{StaticResource CiHint}" />
                    </Grid>
                </DockPanel>
                <DockPanel x:Name="FilterResultsGrid" LastChildFill="True" Margin="0,2,10,2">
                    <CheckBox x:Name="FilterRegEx" DockPanel.Dock="Right" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.RegExLabel}" Margin="4,0,0,0" VerticalContentAlignment="Center" IsChecked="True" Click="FilterRegEx_Click" />
                    <Grid>
                        <TextBox x:Name="FilterResultsInput" TabIndex="3" Width="150" Style="{StaticResource CiTextBox}" TextChanged="FilterResultsInput_TextChanged" />
                        <TextBlock x:Name="FilterResultsLabel" Text="{x:Static resx:Resources.FilterResultsLabel}" Style="{StaticResource CiHint}" />
                    </Grid>
                </DockPanel>
                <StackPanel x:Name="FileTypesGrid" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                    <TextBlock x:Name="FileTypesLabel" Text="{x:Static resx:Resources.FileTypesLabel}" Style="{DynamicResource NormalTextBlock}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="FileTypesComboBox" Width="200" Style="{StaticResource CiComboBox}" SelectionChanged="FileTypesComboBox_SelectionChanged" ToolTip="{x:Static resx:Resources.FileTypesTooltip}" ToolTipService.InitialShowDelay="250" />
                </StackPanel>
                <WrapPanel x:Name="CustomFlagsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,6,2">
                    <CheckBox x:Name="CK1" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.CustomFlagCommentsLabel}" Click="CustomFlag_Click" ToolTip="{x:Static resx:Resources.CustomFlagCommentsTooltip}" />
                    <CheckBox x:Name="CK2" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.CustomFlagCurrentFileLabel}" Click="CustomFlag_Click" ToolTip="{x:Static resx:Resources.CustomFlagCurrentFileTooltip}" />
                    <CheckBox x:Name="CK3" Style="{StaticResource CiCheckBox}" Content="{x:Static resx:Resources.CustomFlagExcludeDesignerLabel}" Click="CustomFlag_Click" ToolTip="{x:Static resx:Resources.CustomFlagExcludeDesignerTooltip}" />
                    <CheckBox x:Name="CK4" Style="{StaticResource CiCheckBox}" Content="CK4" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK5" Style="{StaticResource CiCheckBox}" Content="CK5" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK6" Style="{StaticResource CiCheckBox}" Content="CK6" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK7" Style="{StaticResource CiCheckBox}" Content="CK7" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK8" Style="{StaticResource CiCheckBox}" Content="CK8" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK9" Style="{StaticResource CiCheckBox}" Content="CK9" Click="CustomFlag_Click" />
                    <CheckBox x:Name="CK10" Style="{StaticResource CiCheckBox}" Content="CK10" Click="CustomFlag_Click" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Button x:Name="SearchButton" Style="{StaticResource CiAccentButton}" Content="{x:Static resx:Resources.SearchButtonContent}" Click="SearchButton_Click" />
                    <Button x:Name="HistoryButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.HistoryButtonContent}" Click="HistoryButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Name="HistoryContextMenu" Style="{StaticResource OtherContextMenu}">
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </WrapPanel>

            <!-- ===== 第二行：配置下拉 + 索引/设置按钮（对应 CodeIndex 的索引行） ===== -->
            <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                    <Label Style="{StaticResource CiLabel}" Content="{x:Static resx:Resources.ConfigLabel}" />
                    <wpfTool:CheckComboBox x:Name="FiltersComboBox" Width="200" VerticalAlignment="Center" Visibility="Collapsed" DisplayMemberPath="Name" ValueMemberPath="Name" SelectedMemberPath="Name" Delimiter=", " ItemsSource="{Binding}" ItemSelectionChanged="FiltersComboBox_ItemSelectionChanged">
                    </wpfTool:CheckComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Button x:Name="InitButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.UpdateIndex}" Click="InitButton_Click" />
                    <Button x:Name="CleanButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.CleanAndUpdateIndex}" Click="CleanButton_Click" />
                    <Button x:Name="StopButton" Style="{StaticResource CiWarnButton}" Content="{x:Static resx:Resources.StopButtonContent}" Click="StopButton_Click" Visibility="Collapsed" />
                    <Button x:Name="KeyboardButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.CustomizeShortcuts}" Click="KeyboardButton_Click" />
                    <Button x:Name="AdvancedButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.AdvancedSettings}" Click="AdvancedButton_Click" />
                    <Button x:Name="PathsButton" Style="{StaticResource CiButton}" Content="{x:Static resx:Resources.SearchConfigurations}" Click="PathsButton_Click" />
                </StackPanel>
            </WrapPanel>

            <!-- ===== 底部：结果信息 + 索引状态 ===== -->
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,4,0,0">
                <ProgressBar x:Name="UpdateProgress" DockPanel.Dock="Right" Width="180" Height="6" Margin="6,0,0,0" IsTabStop="False" VerticalAlignment="Center" />
                <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Right" Style="{DynamicResource SomeHintLabel}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="InitInfo" DockPanel.Dock="Right" Style="{DynamicResource SomeHintLabel}" Margin="8,0,0,0" VerticalAlignment="Center" Text="" />
                <TextBlock x:Name="InfoLabel" Style="{DynamicResource SomeHintLabel}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- ===== 结果区 ===== -->
            <Grid Margin="0,4,0,0">
                <ListBox x:Name="SearchItemsListBox" Style="{DynamicResource ResultsListBox}" TabIndex="4" ItemsSource="{Binding}" KeyboardNavigation.TabNavigation="Once">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Style="{DynamicResource ResultPanel}" MouseDown="SearchResult_MouseDown" >
                                <Image Margin="4,0,-8,0" Width="16" Height="16" Source="{Binding ImageSource}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Style="{DynamicResource ResultFile}" Text="{Binding Path=TrimmedFileAndLine}" />
                                <TextBlock Style="{DynamicResource ResultTextStart}" Text="{Binding Path=BeginText}" />
                                <TextBlock Style="{DynamicResource ResultHighlightedText}" Text="{Binding Path=HighlightedText}"/>
                                <TextBlock Style="{DynamicResource ResultTextEnd}" Text="{Binding Path=EndText}" />
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuGoTo" Header="{x:Static resx:Resources.MenuGoTo}" InputGestureText="Enter" Click="MenuGoTo_Click"/>
                                        <MenuItem x:Name="MenuIncludeFile" Header="{x:Static resx:Resources.IncludeFile}" InputGestureText="Shift+Enter" Click="MenuIncludeFile_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=IsActiveDocumentCpp}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="MenuCopyText" Header="{x:Static resx:Resources.MenuCopyText}" InputGestureText="Ctrl+C" Click="MenuCopyText_Click"/>
                                        <MenuItem x:Name="MenuCopyFullPath" Header="{x:Static resx:Resources.MenuCopyFullPath}" Click="MenuCopyFullPath_Click"/>
                                        <MenuItem x:Name="MenuCopyResult" Header="{x:Static resx:Resources.MenuCopyResult}" Click="MenuCopyResult_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuCopyAllResults" Header="{x:Static resx:Resources.MenuCopyAllResults}" Click="MenuCopyAllResults_Click"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TreeView x:Name="SearchItemsTreeView" TabIndex="4" ItemsSource="{Binding}" KeyboardNavigation.TabNavigation="Once">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource SomeTreeViewItem}">
                            <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                            <EventSetter Event="PreviewMouseDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                            <EventSetter Event="Selected" Handler="OnSelected"/>
                            <Setter Property="IsExpanded" Value="{Binding Path=IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding Path=IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type modelViews:SearchResultGroup}" ItemsSource="{Binding SearchResults}">
                            <DockPanel Style="{DynamicResource ResultGroupPanel}" RequestBringIntoView="TreeViewItem_RequestBringIntoView" MouseDown="SearchResult_MouseDown">
                                <TextBlock Style="{DynamicResource ResultGroupFile}" Text="{Binding Path=TrimmedFile}" />
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuGoTo" Header="{x:Static resx:Resources.MenuGoTo}" InputGestureText="Enter" Click="MenuGoTo_Click"/>
                                        <MenuItem x:Name="MenuIncludeFile" Header="{x:Static resx:Resources.IncludeFile}" InputGestureText="Shift+Enter" Click="MenuIncludeFile_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=IsActiveDocumentCpp}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem x:Name="MenuCopyFullPath" Header="{x:Static resx:Resources.MenuCopyFullPath}" InputGestureText="Ctrl+C" Click="MenuCopyFullPath_Click"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type modelViews:SearchResult}">
                            <DockPanel Style="{DynamicResource ResultPanel}" MouseDown="SearchResult_MouseDown">
                                <TextBlock Style="{DynamicResource ResultLine}" Text="{Binding Path=Line}" />
                                <Border Style="{DynamicResource ResultSeparator}"/>
                                <TextBlock Style="{DynamicResource ResultTextStart}" Text="{Binding Path=BeginText}" />
                                <TextBlock Style="{DynamicResource ResultHighlightedText}" Text="{Binding Path=HighlightedText}"/>
                                <TextBlock Style="{DynamicResource ResultTextEnd}" Text="{Binding Path=EndText}" />
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuGoTo" Header="{x:Static resx:Resources.MenuGoTo}" InputGestureText="Enter"  Click="MenuGoTo_Click"/>
                                        <MenuItem x:Name="MenuIncludeFile" Header="{x:Static resx:Resources.IncludeFile}" InputGestureText="Shift+Enter" Click="MenuIncludeFile_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=IsActiveDocumentCpp}" Value="false">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem x:Name="MenuCopyText" Header="{x:Static resx:Resources.MenuCopyText}" InputGestureText="Ctrl+C"  Click="MenuCopyText_Click"/>
                                        <MenuItem x:Name="MenuCopyFullPath" Header="{x:Static resx:Resources.MenuCopyFullPath}" Click="MenuCopyFullPath_Click"/>
                                        <MenuItem x:Name="MenuCopyResult" Header="{x:Static resx:Resources.MenuCopyResult}" Click="MenuCopyResult_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuCopyAllResults" Header="{x:Static resx:Resources.MenuCopyAllResults}" Click="MenuCopyAllResults_Click"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                            </DockPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <Border x:Name="Overlay" Style="{DynamicResource OverlayBorder}" />
                <TextBlock x:Name="WarningText" Style="{DynamicResource OverlayText}" Text="{x:Static resx:Resources.NoSolutionLoaded}" />
            </Grid>
        </DockPanel>

        <!-- ===== 崩溃报告遮罩（覆盖整个窗体） ===== -->
        <Border x:Name="CrashReportOverlay" Style="{DynamicResource OverlayBorder}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Margin="5" Text="{x:Static resx:Resources.CrashMessage}" />
                <Border Style="{DynamicResource SomeBorderStyle}" MaxWidth="700" MaxHeight="200" Height="Auto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CrashReportStack">
                        </TextBlock>
                    </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                    <Button x:Name="SendReport" Content="{x:Static resx:Resources.SendReport}" Margin="0,0,5,0" Click="SendReport_Click" ToolTip="{x:Static resx:Resources.SendReportTooltip}" ToolTipService.InitialShowDelay="500" />
                    <Button x:Name="DontSend" Content="{x:Static resx:Resources.DontSend}" Margin="0,0,5,0" Click="DontSend_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
